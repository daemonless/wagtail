#!/bin/sh
# Wagtail (Django CMS) service.
#
# Wagtail is a framework, not a runnable app: on first start we scaffold a fresh
# site into the /config volume (so the user owns/edits it), then serve it with
# gunicorn. Static files are served by WhiteNoise (no separate web server).
#
# Database: SQLite by default (a file in the volume). Set DATABASE_URL to use
# Postgres (e.g. postgres://user:pass@host:5432/db).
set -e

PROJECT_DIR=/config/app
SITE_NAME=app
PORT=8080
PY=/usr/local/bin/python3

# gunicorn writes its control socket under $HOME (~/.gunicorn); point it at the
# writable /config so it doesn't fail on /root/.gunicorn as the bsd user.
export HOME=/config

# wagtail console-script name varies by python flavor; fall back to the module.
if command -v wagtail >/dev/null 2>&1; then
    WAGTAIL="wagtail"
else
    WAGTAIL="$PY -m wagtail.bin.wagtail"
fi

mkdir -p /config
chown bsd:bsd /config

# --- First run: scaffold a Wagtail project into the volume ---------------------
if [ ! -f "${PROJECT_DIR}/manage.py" ]; then
    echo "[wagtail] No project at ${PROJECT_DIR} — bootstrapping a new site..."
    mkdir -p "${PROJECT_DIR}"
    chown bsd:bsd "${PROJECT_DIR}"
    s6-setuidgid bsd $WAGTAIL start "${SITE_NAME}" "${PROJECT_DIR}"
    chown -R bsd:bsd "${PROJECT_DIR}"
fi

cd "${PROJECT_DIR}"

# SECRET_KEY: production needs one. Generate + persist if the user didn't supply it.
if [ -z "$SECRET_KEY" ]; then
    if [ ! -f /config/.secret_key ]; then
        $PY -c 'import secrets; print(secrets.token_urlsafe(50))' > /config/.secret_key
        chown bsd:bsd /config/.secret_key
        chmod 600 /config/.secret_key
    fi
    SECRET_KEY="$(cat /config/.secret_key)"
fi
export SECRET_KEY

# --- daemonless settings overlay (rewritten every start, so image updates apply
#     to existing sites; layered on top of the user's generated production.py) ---
cat > "${PROJECT_DIR}/${SITE_NAME}/settings/daemonless.py" <<'PYEOF'
# Generated by the daemonless wagtail image — rewritten on every start.
from .production import *  # noqa
import os as _os

SECRET_KEY = _os.environ["SECRET_KEY"]
ALLOWED_HOSTS = _os.environ.get("WAGTAIL_ALLOWED_HOSTS", "*").split(",")
STATIC_ROOT = _os.path.join(BASE_DIR, "static")
MEDIA_ROOT = _os.path.join(BASE_DIR, "media")

# Serve static files straight from gunicorn via WhiteNoise (no separate web server).
MIDDLEWARE = list(MIDDLEWARE)
if "whitenoise.middleware.WhiteNoiseMiddleware" not in MIDDLEWARE:
    MIDDLEWARE.insert(1, "whitenoise.middleware.WhiteNoiseMiddleware")

# Postgres if DATABASE_URL is set; otherwise the generated SQLite default stays.
if _os.environ.get("DATABASE_URL"):
    from urllib.parse import urlparse as _urlparse
    _u = _urlparse(_os.environ["DATABASE_URL"])
    DATABASES = {"default": {
        "ENGINE": "django.db.backends.postgresql",
        "NAME": _u.path.lstrip("/"),
        "USER": _u.username or "",
        "PASSWORD": _u.password or "",
        "HOST": _u.hostname or "",
        "PORT": str(_u.port or 5432),
        "CONN_MAX_AGE": 600,
    }}
PYEOF
chown bsd:bsd "${PROJECT_DIR}/${SITE_NAME}/settings/daemonless.py"

export DJANGO_SETTINGS_MODULE="${SITE_NAME}.settings.daemonless"
export PYTHONUNBUFFERED=1

# --- Wait for Postgres if DATABASE_URL points at it ----------------------------
case "$DATABASE_URL" in
  postgres*://*)
    echo "[wagtail] Waiting for database..."
    until $PY - <<'PYEOF' 2>/dev/null
import os, psycopg
from urllib.parse import urlparse
u = urlparse(os.environ["DATABASE_URL"])
psycopg.connect(host=u.hostname, port=u.port or 5432, dbname=u.path.lstrip("/"),
                user=u.username, password=u.password).close()
PYEOF
    do
        sleep 2
    done
    echo "[wagtail] Database is ready." ;;
esac

# --- Migrate + collect static --------------------------------------------------
echo "[wagtail] Applying migrations..."
s6-setuidgid bsd $PY manage.py migrate --noinput
s6-setuidgid bsd $PY manage.py collectstatic --noinput -v 0

# --- Optional admin superuser from env -----------------------------------------
if [ -n "$WAGTAIL_SUPERUSER_NAME" ] && [ -n "$WAGTAIL_SUPERUSER_PASSWORD" ]; then
    echo "[wagtail] Ensuring superuser '${WAGTAIL_SUPERUSER_NAME}'..."
    s6-setuidgid bsd env DJANGO_SUPERUSER_PASSWORD="$WAGTAIL_SUPERUSER_PASSWORD" \
        $PY manage.py createsuperuser --noinput \
        --username "$WAGTAIL_SUPERUSER_NAME" \
        --email "${WAGTAIL_SUPERUSER_EMAIL:-admin@example.com}" 2>/dev/null || true
fi

# --- Serve ---------------------------------------------------------------------
echo "[wagtail] Starting gunicorn on :${PORT}..."
exec s6-setuidgid bsd gunicorn "${SITE_NAME}.wsgi:application" \
    --bind "0.0.0.0:${PORT}" \
    --workers "${WAGTAIL_WORKERS:-3}"
